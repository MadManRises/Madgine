plugins {
    id 'com.android.application' version '9.4.0'
    id 'com.android.library' version '9.4.0' apply false
}

android {
    namespace "com.@PROJECT_NAME@.@target@"

    compileSdkVersion 35

    defaultConfig {
        applicationId "com.@PROJECT_NAME@.@target@"
        minSdkVersion @ANDROID_PLATFORM_LEVEL@
        targetSdkVersion @ANDROID_PLATFORM_LEVEL@
        multiDexEnabled = true
    }


    buildTypes {
        release {
            versionNameSuffix ""
            debuggable false
            zipAlignEnabled true
            minifyEnabled true
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }


    sourceSets {
        main {
            manifest.srcFile 'AndroidManifest.xml'
            jniLibs.srcDirs = ['bin/', '@CMAKE_ANDROID_NDK@/sources/cxx-stl/llvm-libc++/libs/' @ANDROID_ADDITIONAL_DEPENDENCIES@]
			assets.srcDirs = ['../MadgineLauncher/assets/']
            res.srcDirs = ['@MADGINE_CONFIGURATION@/res' @ANDROID_ADDITIONAL_RESOURCES@]
            java.srcDirs = [@ANDROID_ADDITIONAL_SOURCES@]
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }

}

dependencies {
  implementation "com.google.android.gms:play-services-games-v2:+"
}